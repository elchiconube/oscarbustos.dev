---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/header/Header.tsx';
import Video from '@/components/Video.astro';
import CustomCursor from '@/components/CustomCursor.astro';
import Snowfall from '@/components/Snowfall.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = 'Oscar Bustos',
  description = 'Senior Frontend Developer',
  image,
  type,
  publishedTime,
  modifiedTime,
} = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <ClientRouter fallback='swap' />
    <Font cssVariable='--nunito-font' preload />
    <Font cssVariable='--fraunces-font' />
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <!--
      En <head> para aplicar el tema antes del primer pintado (sin parpadeo).
      Solo se persiste en localStorage cuando el usuario elige un tema con el toggle,
      así se sigue respetando la preferencia del sistema mientras no haya elección.
    -->
    <script is:inline>
      (() => {
        const getPreferredTheme = () => {
          try {
            const stored = localStorage.getItem('theme');
            if (stored === 'light' || stored === 'dark') return stored;
          } catch {
            /* localStorage no disponible */
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };

        const setTheme = (root, theme) => {
          root.classList.remove('light', 'dark');
          root.classList.add(theme);
          root.setAttribute('data-theme', theme);
        };

        setTheme(document.documentElement, getPreferredTheme());

        // ClientRouter: aplicar el tema al documento nuevo antes de mostrarlo.
        document.addEventListener('astro:before-swap', (ev) => {
          setTheme(ev.newDocument.documentElement, getPreferredTheme());
        });

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
          setTheme(document.documentElement, getPreferredTheme());
        });
      })();
    </script>
  </head>
  <body>
    <Snowfall />
    <CustomCursor />
    <main>
      <Header client:idle />
      <slot />
      <Video />
      <Footer />
    </main>
  </body>
</html>
