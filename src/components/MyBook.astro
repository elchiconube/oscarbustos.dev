---
import Heading from '@/components/Heading.astro';
import Cover from '@/components/Cover.astro';
import Button from '@/components/Button.astro';
import Features from '@/components/Features.astro';

const books = [
  {
    cover: '/claude-code.webp',
    alt: 'Portada de Claude Code - Guía no oficial',
    title: 'Claude Code - Guía no oficial',
    subtitle: 'Cómo dirigir a un agente de código sin perder el control (ni la cabeza)',
    body: 'Guía no oficial en español para maximizar el uso de Claude Code y aumentar tu productividad. Aprende a dirigir al agente, acotar sesiones largas, escribir un CLAUDE.md que se cumple y delegar trabajo repetitivo sin perder el control.',
    features: [
      'Escrito en español',
      'Aumenta tu productividad',
      'Documentación oficial',
    ],
    buyUrl: 'https://leanpub.com/claudecode-guia-no-oficial',
    buyTitle: 'Comprar Claude Code - Guía no oficial en Leanpub',
  },
  {
    cover: '/cover.webp',
    alt: 'Iniciate en el mundo del desarrollo web',
    title: 'Desarrollo Frontend',
    subtitle: 'Fácil y práctico para todos los públicos',
    body: 'Con este libro podrás aprender desde 0 las tecnologías básicas sobre las que se sustentan el desarrollo web. Explicado con multitud de casos prácticos y ejercicios que te ayudarán a entenderlo de una manera sencilla',
    features: [
      'Acceso a comunidad privada',
      'Acceso a contenidos actualizados',
      'Aprenderás HTML5, CSS3, Javascript',
      'Tendrás ejercicios prácticos',
    ],
    buyUrl: 'https://leanpub.com/desarrollo-frontend',
    buyTitle: 'Comprar Aprende a crear páginas web desde 0 en Leanpub',
  },
];
---

<section class="section">
  <Heading title="Books" description="Guías en español para desarrolladores" />
  <div class="books">
    {books.map((book) => (
      <div class="wrapper">
        <Cover src={book.cover} alt={book.alt} />
        <article>
          <h3>{book.title}</h3>
          <p class="subtitle">{book.subtitle}</p>
          <p>{book.body}</p>
          <Features features={book.features} />
          <Button
            href={book.buyUrl}
            target="_blank"
            rel="noopener noreferrer"
            title={book.buyTitle}
            text="Comprar"
          />
        </article>
      </div>
    ))}
  </div>
</section>

<style>
  .books {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .wrapper {
    color: var(--text-color);
    display: grid;
    align-items: flex-start;
    justify-content: center;
    gap: 24px;
    grid-template-columns: 480px 1fr;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .subtitle {
    font-family: sans-serif;
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 12px;
    color: var(--text-color);
  }

  article h3 {
    margin-bottom: 8px;
  }

  @media screen and (max-width: 768px) {
    .wrapper {
      grid-template-columns: 1fr;
      gap: 80px;
    }

    .books {
      gap: 96px;
    }
  }
</style>
