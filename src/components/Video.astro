---
import Button from '@/components/Button.astro';

const CLOUDINARY = 'https://res.cloudinary.com/elchiconube/video/upload';
---

<article>
  <div>
    <h2>Is it a match?</h2>
    <p>
      If you need help or advice, feel free to drop us a message via social
      media or email
    </p>
    <Button href='mailto:oscarbustosgarrido@gmail.com' text='Contact me' />
  </div>
  <!--
    preload="none" + poster: el vídeo (antes 6,2 MB en cada página) solo se
    descarga cuando se acerca al viewport, y nunca con prefers-reduced-motion.
  -->
  <video
    class='footer-video'
    muted
    loop
    playsinline
    preload='none'
    aria-hidden='true'
    poster={`${CLOUDINARY}/so_0,w_1280,q_auto/v1528758653/video_ckbyru.jpg`}
    data-src={`${CLOUDINARY}/w_1280,q_auto:low/v1528758653/video_ckbyru.mp4`}
  >
  </video>
</article>

<style>
  div {
    position: absolute;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 450px;
  }
  video {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    object-fit: cover;
  }

  h2 {
    position: relative;
    z-index: 4;
    font-family: var(--fraunces-font);
    font-size: 42px;
    color: white;
    font-weight: 400;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
  }

  p {
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    color: white;
  }

  article {
    position: relative;
    text-align: center;
    height: 440px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 48px 0 0;
  }

  article:before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgba(0, 0, 0, 0.2);
    z-index: 3;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  function initFooterVideo() {
    const video = document.querySelector<HTMLVideoElement>('video.footer-video');
    if (!video?.dataset.src) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const load = () => {
      if (!video.src) video.src = video.dataset.src ?? '';
      video.play().catch(() => {
        /* autoplay bloqueado: se queda el póster */
      });
    };

    if (!('IntersectionObserver' in window)) {
      load();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            load();
          } else if (video.src) {
            video.pause();
          }
        }
      },
      { rootMargin: '200px 0px' }
    );
    observer.observe(video);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  document.addEventListener('astro:page-load', initFooterVideo);
</script>
