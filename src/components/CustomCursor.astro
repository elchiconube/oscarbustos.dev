<!--
  transition:persist mantiene estos nodos entre navegaciones de ClientRouter.
  Sin él, el <body> se sustituye, el script (que solo se ejecuta una vez) sigue
  apuntando al nodo antiguo y el usuario se queda sin cursor visible.
-->
<div id='custom-cursor' aria-hidden='true' transition:persist='custom-cursor'></div>
<click-spark aria-hidden='true' transition:persist='click-spark'></click-spark>

<style>
  :root[data-theme='light'] {
    --cursor-color: #000000;
    --click-spark-color: #000000;
  }

  :root[data-theme='dark'] {
    --cursor-color: #ffffff;
    --click-spark-color: #ffffff;
  }

  /* Solo ratón/trackpad: ocultar cursor del sistema y mostrar el punto tras el primer movimiento */
  @media (pointer: fine) {
    * {
      cursor: none !important;
    }

    #custom-cursor {
      width: 8px;
      height: 8px;
      background-color: var(--cursor-color);
      border-radius: 50%;
      position: fixed;
      left: 0;
      top: 0;
      pointer-events: none;
      z-index: 9999;
      opacity: 0;
      transition:
        opacity 0.15s ease,
        background-color 0.3s ease;
      will-change: transform;
    }

    #custom-cursor.is-ready {
      opacity: 1;
    }

    click-spark {
      display: block;
    }
  }

  /* Táctil: sin cursor falso en la esquina ni cursor oculto */
  @media (pointer: coarse) {
    #custom-cursor,
    click-spark {
      display: none !important;
    }
  }
</style>

<script>
  class ClickSpark extends HTMLElement {
    private svg: SVGSVGElement | null = null;

    constructor() {
      super();
      this.attachShadow({ mode: 'open' });
    }

    connectedCallback() {
      const sr = this.shadowRoot;
      if (!sr) return;
      sr.innerHTML = this.createSpark();
      this.svg = sr.querySelector('svg');
      document.addEventListener('click', this);
    }

    disconnectedCallback() {
      document.removeEventListener('click', this);
    }

    handleEvent(e: Event) {
      if (!(e instanceof MouseEvent)) return;
      this.setSparkPosition(e);
      this.animateSpark();
    }

    animateSpark() {
      if (!this.svg) return;
      const sparks = [...this.svg.children];
      const first = sparks[0];
      if (!first) return;
      const size = parseInt(first.getAttribute('y1') ?? '0', 10);
      const offset = size / 2 + 'px';
      const keyframes = (i: number): Keyframe[] => {
        const deg = `calc(${i} * (360deg / ${sparks.length}))`;
        return [
          {
            strokeDashoffset: size * 3,
            transform: `rotate(${deg}) translateY(${offset})`,
          },
          {
            strokeDashoffset: size,
            transform: `rotate(${deg}) translateY(0)`,
          },
        ];
      };
      const options: KeyframeAnimationOptions = {
        duration: 660,
        easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
        fill: 'forwards',
      };
      sparks.forEach((spark, i) => spark.animate(keyframes(i), options));
    }

    setSparkPosition(e: MouseEvent) {
      this.style.left = e.pageX - this.clientWidth / 2 + 'px';
      this.style.top = e.pageY - this.clientHeight / 2 + 'px';
    }

    createSpark() {
      return `
        <style>
          :host {
            position: absolute;
            pointer-events: none;
            z-index: 9998;
          }
        </style>
        <svg width="30" height="30" viewBox="0 0 100 100" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" stroke="var(--click-spark-color, currentcolor)" transform="rotate(-20)">
          ${Array.from(
            { length: 8 },
            () =>
              '<line x1="50" y1="30" x2="50" y2="4" stroke-dasharray="30" stroke-dashoffset="30" style="transform-origin: center" />'
          ).join('')}
        </svg>
      `;
    }
  }

  if (!customElements.get('click-spark')) {
    customElements.define('click-spark', ClickSpark);
  }

  function setupCustomCursor() {
    if (!window.matchMedia('(pointer: fine)').matches) return;

    let x = 0;
    let y = 0;
    let pressed = false;

    // Se busca el nodo en cada evento por si alguna página no lo persiste.
    const getCursor = () => document.getElementById('custom-cursor');

    const render = () => {
      const cursor = getCursor();
      if (!cursor) return;
      cursor.style.transform = `translate(${x}px, ${y}px)${pressed ? ' scale(0.8)' : ''}`;
      cursor.classList.add('is-ready');
    };

    document.addEventListener(
      'pointermove',
      (e) => {
        x = e.clientX;
        y = e.clientY;
        render();
      },
      { passive: true }
    );

    document.addEventListener('pointerdown', () => {
      pressed = true;
      render();
    });

    document.addEventListener('pointerup', () => {
      pressed = false;
      render();
    });
  }

  setupCustomCursor();
</script>
