---
import Heading from '@/components/Heading.astro';
import MainLayout from '@/layouts/MainLayout.astro';

import TimelinePosts from '@/components/TimelinePosts.astro';

const timelineEntries = [
  {
    year: '2025',
    highlight: true,
    content:
      'Joined BQ Educación as a Senior Frontend Developer, leading the evolution of SmartBooQs — an educational platform focused on interactive and personalized digital learning.',
  },
  {
    year: '2024',
    highlight: false,
    content:
      'Joined FCM Travel as a Senior Frontend Developer, building new product features and contributing to the Nexus component library alongside the design team.',
  },
  {
    year: '2022',
    highlight: true,
    content: [
      'Joined marketgoo as Frontend Team Lead, driving component-based architecture, testing strategy, and mentoring while shipping features faster with React and TypeScript.',
      'Launched my personal project "topdelmes.com," an AI-powered platform for ranking movies and series.',
    ],
  },
  {
    year: '2019',
    highlight: true,
    content: [
      'Became Frontend Team Lead at urbanData Analytics by Accumin, leading a major product refactor, raising code quality, and creating an open-source React component library.',
    ],
  },
  {
    year: '2015',
    highlight: true,
    content: [
      'Joined BTS as Frontend Team Lead, building a knowledge management platform with React, Strapi, and AWS in a distributed international team.',
      'Started as Associate Professor at U-tad, mentoring students in a real working environment for digital careers.',
    ],
  },
  {
    year: '2013',
    content: [
      'Joined Axel Springer España as Frontend Team Lead, heading frontend development for high-traffic sites like Autobild, Computerhoy, and Hobbyconsolas on Drupal 8.',
    ],
  },
  {
    year: '2011',
    content:
      'Started my journey as a Frontend Developer at Vocento, working on responsive web projects with HTML5, CSS, JavaScript, Twig, and Magento.',
  },
];
---

<MainLayout>
  <Heading title='Timeline' description='My professional career' />

  <section class='section'>
    <TimelinePosts entries={timelineEntries} />
  </section>
</MainLayout>
